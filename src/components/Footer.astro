---
import type { Lang } from '../i18n/translations';
import { t } from '../i18n/translations';

interface Props {
  lang: Lang;
  currentPath: string;
  alternates?: { lang: string; url: string }[];
}

const { lang, currentPath, alternates } = Astro.props;
const year = new Date().getFullYear();

const aboutSlugs: Record<string, string> = {
  fr: 'a-propos', en: 'about', es: 'acerca-de', pt: 'sobre', it: 'chi-siamo',
};

const legalSlugs: Record<string, string> = {
  fr: 'mentions-legales', en: 'legal', es: 'aviso-legal', pt: 'aviso-legal', it: 'avviso-legale',
};

const langNames: Record<string, string> = {
  fr: 'FR', en: 'EN', es: 'ES', pt: 'PT', it: 'IT',
};

function getPathForLang(targetLang: string): string {
  if (alternates) {
    const alt = alternates.find((a) => a.lang === targetLang);
    if (alt) return alt.url;
  }
  if (currentPath.match(/\/(guide|review|compare)\//)) {
    return `/${targetLang}/`;
  }
  const pathWithoutLang = currentPath.replace(/^\/(fr|en|es|pt|it)/, '');
  return `/${targetLang}${pathWithoutLang || '/'}`;
}
---

<footer class="footer">
  <div class="fg-container footer-inner">
    <div class="footer-brand">
      <span class="footer-logo">
        <span class="logo-facil">facil</span><span class="logo-dot">.</span><span class="logo-guide">guide</span>
      </span>
      <p class="footer-tagline">{t(lang, 'footer.tagline')}</p>
    </div>

    <nav class="footer-nav" aria-label={lang === 'fr' ? 'Navigation du pied de page' : lang === 'pt' ? 'Navegacao do rodape' : 'Footer navigation'}>
      <a href={`/${lang}/${aboutSlugs[lang]}/`}>{t(lang, 'nav.about')}</a>
      <a href={`/${lang}/${legalSlugs[lang]}/`}>{t(lang, 'nav.legal')}</a>
      <a href="#" class="footer-email" data-u="facil" data-d="dropthe.org">facil [at] dropthe.org</a>
    </nav>

    <div class="footer-lang">
      {Object.entries(langNames).map(([code, name]) => (
        <a
          href={getPathForLang(code)}
          class:list={['footer-lang-link', { active: code === lang }]}
          hreflang={code}
        >
          {name}
        </a>
      ))}
    </div>

    <div class="footer-bottom">
      <p class="footer-privacy">{t(lang, 'footer.privacy')}</p>
      <p class="footer-independent">
        {t(lang, 'footer.independent')}
      </p>
      <p class="footer-copy">
        {year} facil.guide
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--fg-bg-card);
    border-top: 1px solid var(--fg-border);
    margin-top: auto;
    padding: 2.5rem 0 2rem;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .footer-logo { font-size: 1.1rem; font-weight: 700; }
  .logo-facil { color: var(--fg-primary); }
  .logo-dot { color: var(--fg-accent); }
  .logo-guide { color: var(--fg-text); }

  .footer-tagline {
    color: var(--fg-text-muted);
    font-size: 0.9rem;
    margin-bottom: 0;
    margin-top: 0.25rem;
  }

  .footer-lang {
    display: flex;
    gap: 0.25rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer-lang-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--fg-border);
    border-radius: var(--fg-radius-sm);
    text-decoration: none;
    color: var(--fg-text-muted);
    font-size: 0.8rem;
    font-weight: 600;
    min-height: 36px;
    transition: all 0.12s ease;
  }

  .footer-lang-link:hover {
    border-color: var(--fg-primary);
    color: var(--fg-primary);
  }

  .footer-lang-link.active {
    border-color: var(--fg-primary);
    color: var(--fg-primary);
    background: var(--fg-bg-warm);
  }

  .footer-nav {
    display: flex;
    gap: 1.5rem;
  }

  .footer-nav a {
    color: var(--fg-text-muted);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .footer-nav a:hover { color: var(--fg-primary); }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--fg-border);
    width: 100%;
    max-width: 400px;
  }

  .footer-privacy {
    color: var(--fg-text-muted);
    font-size: 0.8rem;
    margin-bottom: 0;
    opacity: 0.8;
  }

  .footer-copy {
    color: var(--fg-text-muted);
    font-size: 0.8rem;
    margin-bottom: 0;
  }

  .footer-independent {
    color: var(--fg-text-muted);
    font-size: 0.8rem;
    margin-bottom: 0;
  }
</style>
<script is:inline>
  (function() {
    var el = document.querySelector('.footer-email');
    if (el) {
      var u = el.getAttribute('data-u');
      var d = el.getAttribute('data-d');
      el.textContent = u + '@' + d;
      el.href = 'mailto:' + u + '@' + d;
    }
  })();
</script>
