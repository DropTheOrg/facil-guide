---
import { languages } from '../i18n/translations';
import type { Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
  currentPath: string;
  alternates?: { lang: string; url: string }[];
}

const { lang, currentPath, alternates } = Astro.props;

function getPathForLang(targetLang: Lang): string {
  if (alternates) {
    const alt = alternates.find((a) => a.lang === targetLang);
    if (alt) return alt.url;
  }
  const pathWithoutLang = currentPath.replace(/^\/(fr|en|es|pt|it)/, '');
  return `/${targetLang}${pathWithoutLang || '/'}`;
}
---

<div class="lang-switcher">
  {Object.entries(languages).map(([code, name]) => (
    <a
      href={getPathForLang(code as Lang)}
      class:list={['lang-option', { active: code === lang }]}
      aria-label={name}
      aria-current={code === lang ? 'true' : undefined}
      hreflang={code}
    >
      {code.toUpperCase()}
    </a>
  ))}
</div>

<style>
  .lang-switcher {
    display: flex;
    align-items: center;
    gap: 1px;
    flex-shrink: 0;
    background: var(--fg-border);
    border-radius: var(--fg-radius-sm);
    overflow: hidden;
  }

  .lang-option {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    min-height: 36px;
    padding: 0.2rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--fg-text-muted);
    text-decoration: none;
    background: var(--fg-bg-card);
    border: none;
    transition: color 0.1s ease, background-color 0.1s ease;
  }

  .lang-option:hover {
    color: var(--fg-primary);
    background-color: var(--fg-bg-warm);
  }

  .lang-option.active {
    color: var(--fg-primary);
    background-color: var(--fg-bg-warm);
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .lang-option {
      min-width: 32px;
      min-height: 32px;
      font-size: 0.7rem;
    }
  }
</style>
