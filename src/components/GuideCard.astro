---
import type { Lang } from '../i18n/translations';
import { t, getCategoryName, getDifficultyName } from '../i18n/translations';
import type { Category } from '../i18n/translations';
import { getPlatformLabel } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  category: Category;
  steps: number;
  difficulty: 'facile' | 'moyen' | 'avance';
  platform: string;
  lang: Lang;
  slug: string;
  heroSrc?: string;
}

const { title, description, category, steps, difficulty, platform, lang, slug, heroSrc } = Astro.props;

const difficultyClass = {
  facile: 'fg-badge-green',
  moyen: 'fg-badge-orange',
  avance: 'fg-badge-blue',
}[difficulty];

const guidePath = `/${lang}/guide/${slug}/`;
const guideUrl = `https://facil.guide${guidePath}`;
const shareLabel = t(lang, 'guide.share');
---

<article class="guide-card fg-card">
  {heroSrc && (
    <div class="guide-card-thumb">
      <a href={guidePath}>
        <img src={heroSrc} alt={title} loading="lazy" decoding="async" class="guide-card-img" />
      </a>
    </div>
  )}

  <div class="guide-card-body">
    <div class="guide-card-header">
      <span class:list={['fg-badge', difficultyClass]}>
        {getDifficultyName(lang, difficulty)}
      </span>
      <span class="guide-card-platform">{getPlatformLabel(platform)}</span>
    </div>

    <h3 class="guide-card-title">
      <a href={guidePath}>{title}</a>
    </h3>

    <p class="guide-card-desc">{description}</p>

    <div class="guide-card-footer">
      <span class="guide-card-meta">
        {steps} {t(lang, 'guide.steps')}
      </span>
      <span class="guide-card-meta">
        ~{Math.max(1, Math.ceil(steps * 1.5))} min
      </span>
    </div>
  </div>
</article>

<style>
  .guide-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }

  .guide-card:hover {
    transform: translateY(-2px);
  }

  .guide-card-thumb {
    overflow: hidden;
  }

  .guide-card-img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 1200 / 632;
    object-fit: cover;
    transition: transform 0.2s ease;
  }

  .guide-card:hover .guide-card-img {
    transform: scale(1.02);
  }

  .guide-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    flex: 1;
  }

  .guide-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .guide-card-platform {
    font-size: 0.8rem;
    color: var(--fg-text-muted);
    font-weight: 500;
  }

  .guide-card-title {
    font-size: 1.1rem;
    margin: 0;
    line-height: 1.4;
  }

  .guide-card-title a {
    color: var(--fg-text);
    text-decoration: none;
  }

  .guide-card-title a:hover {
    color: var(--fg-primary);
  }

  .guide-card-desc {
    color: var(--fg-text-muted);
    font-size: 0.88rem;
    line-height: 1.5;
    margin-bottom: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .guide-card-footer {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: auto;
    padding-top: 0.5rem;
    border-top: 1px solid var(--fg-border);
  }

  .guide-card-meta {
    font-size: 0.8rem;
    color: var(--fg-text-muted);
    font-weight: 500;
  }
</style>
